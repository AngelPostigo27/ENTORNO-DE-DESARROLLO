  <diagram id="wfiMXSFnXa-xWcOfmGeu" name="Página-6">
    <mxGraphModel dx="1280" dy="533" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uX4Gxjta9icmK6KvQsXw-1" value="Imagina que trabajas en un sistema de reservas de vuelos. Hay vuelos nacionales e&lt;br/&gt;internacionales. Ambos tipos de vuelos tienen una fecha, una hora de salida y un precio,&lt;br/&gt;pero los vuelos internacionales tienen un costo adicional debido a los impuestos de viaje. Al&lt;br/&gt;realizar una reserva, el sistema debe calcular el precio total del vuelo, teniendo en cuenta si&lt;br/&gt;es nacional o internacional.&lt;br/&gt;El sistema debe manejar la reserva de vuelos nacionales e internacionales, asegurando que&lt;br/&gt;se apliquen correctamente los impuestos adicionales cuando sea necesario. Los usuarios&lt;br/&gt;deben poder ver el precio total de su vuelo, considerando todos los factores relevantes para&lt;br/&gt;cada tipo de vuelo.&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="169" y="110" width="510" height="160" as="geometry" />
        </mxCell>
